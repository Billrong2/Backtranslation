{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/backtranslation/directions-v1.schema.json",
  "title": "Atomic implementation directions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "directions"
  ],
  "properties": {
    "schema_version": {
      "const": "implementation-directions-v1"
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {
        "$ref": "#/$defs/direction"
      }
    }
  },
  "$defs": {
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "conditions",
        "depends_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{2,}$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "allOf": [
            {"pattern": "^\\S"},
            {"pattern": "\\S$"},
            {"pattern": "^[^\\r\\n\\u0000]*$"}
          ]
        },
        "conditions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "allOf": [
              {"pattern": "^\\S"},
              {"pattern": "\\S$"},
              {"pattern": "^[^\\r\\n\\u0000]*$"}
            ]
          }
        },
        "depends_on": {
          "type": "array",
          "maxItems": 999,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8,
            "pattern": "^D[0-9]{2,}$"
          }
        }
      }
    }
  }
}
